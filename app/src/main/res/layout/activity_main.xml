<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F4F7FB">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Study Score Predictor"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Predict your practice score using AI"
        android:textSize="16sp"
        android:textColor="#52657A"
        android:gravity="center"
        android:layout_marginBottom="28dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Study Hours"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/enterHours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 5"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:textSize="18sp"
        android:backgroundTint="#527AA5"/>

    <Button
        android:id="@+id/predictButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Predict Score"
        android:textSize="18sp"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your predicted score will appear here"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginTop="24dp"/>

</LinearLayout>